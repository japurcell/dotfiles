{
  "displayName": "Opencode",
  "baseImage": "docker.io/library/ubuntu:24.04",
  "installCommands": [
    "apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl git jq openssh-client python3 && rm -rf /var/lib/apt/lists/*",
    "curl -fsSL https://opencode.ai/install | bash",
    "mv $HOME/.opencode/bin/opencode /usr/local/bin/"
  ],
  "launchCommand": ["opencode"],
  "environmentVariables": [],
  "mounts": [
    {
      "hostPath": "~/.agents",
      "containerPath": "/root/.agents",
      "readOnly": true
    },
    {
      "hostPath": "~/.config/opencode",
      "containerPath": "/root/.config/opencode"
    }
  ]
}
