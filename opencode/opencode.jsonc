{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "omlx (local)",
      "options": {
        "baseURL": "http://192.168.64.1:8080/v1",
      },
      "models": {
        "mlx-community--gpt-oss-20b-MXFP4-Q8": {
          "name": "mlx-community--gpt-oss-20b-MXFP4-Q8",
          "limit": {
            "context": 120000,
            "output": 8192,
          },
        },
        "Qwen3-Coder-30B-A3B-Instruct-4bit": {
          "name": "Qwen3-Coder-30B-A3B-Instruct-4bit",
          "limit": {
            "context": 128000,
            "output": 65536,
          },
        },
        "Qwen3.6-35B-A3B-8bit": {
          "name": "Qwen3.6-35B-A3B-8bit",
          "limit": {
            "context": 262144,
            "output": 32768,
          },
        },
      },
    },
  },
}
