{
  "displayName": "Codex",
  "baseImage": "docker.io/library/ubuntu:24.04",
  "installCommands": [
    "apt-get update && apt-get install -y --no-install-recommends build-essential bubblewrap ca-certificates curl git iproute2 jq libicu-dev openssh-client python3 ripgrep && rm -rf /var/lib/apt/lists/*",
    "curl -fsSL https://chatgpt.com/codex/install.sh | sh",
    "ln -s $HOME/.local/bin/codex /usr/local/bin/",
    "curl -L -o /tmp/powershell.tar.gz https://github.com/PowerShell/PowerShell/releases/download/v7.6.5/powershell-7.6.5-linux-arm64.tar.gz",
    "mkdir -p /opt/microsoft/powershell/7",
    "tar zxf /tmp/powershell.tar.gz -C /opt/microsoft/powershell/7",
    "chmod +x /opt/microsoft/powershell/7/pwsh",
    "ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh",
    "curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/master/install.sh | sh"
  ],
  "launchCommand": ["codex", "--yolo"],
  "environmentVariables": [],
  "mounts": [
    {
      "hostPath": "~/.agents",
      "containerPath": "/root/.agents",
      "readOnly": true
    },
    {
      "hostPath": "~/.codex",
      "containerPath": "/root/.codex"
    }
  ]
}
