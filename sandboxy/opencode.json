{
  "displayName": "Opencode",
  "baseImage": "docker.io/library/ubuntu:24.04",
  "installCommands": [
    "apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl git iproute2 jq libicu-dev openssh-client python3 ripgrep xclip && rm -rf /var/lib/apt/lists/*",
    "curl -fsSL https://opencode.ai/install | bash",
    "ln -s $HOME/.opencode/bin/opencode /usr/local/bin/",
    "curl -L -o /tmp/powershell.tar.gz https://github.com/PowerShell/PowerShell/releases/download/v7.6.5/powershell-7.6.5-linux-arm64.tar.gz",
    "mkdir -p /opt/microsoft/powershell/7",
    "tar zxf /tmp/powershell.tar.gz -C /opt/microsoft/powershell/7",
    "chmod +x /opt/microsoft/powershell/7/pwsh",
    "ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh"
  ],
  "launchCommand": ["opencode"],
  "environmentVariables": [],
  "mounts": [
    {
      "hostPath": "~/.agents",
      "containerPath": "/root/.agents",
      "readOnly": true
    },
    {
      "hostPath": "~/.config/opencode",
      "containerPath": "/root/.config/opencode"
    },
    {
      "hostPath": "~/.local/share/opencode",
      "containerPath": "/root/.local/share/opencode"
    },
    {
      "hostPath": "~/.local/state/opencode",
      "containerPath": "/root/.local/state/opencode"
    }
  ]
}
