{
  "displayName": "Pi",
  "baseImage": "docker.io/library/node:24-bookworm-slim",
  "installCommands": [
    "apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl git iproute2 jq libicu-dev openssh-client python3 ripgrep && apt-get clean && rm -rf /var/lib/apt/lists/*",
    "curl -L -o /tmp/powershell.tar.gz https://github.com/PowerShell/PowerShell/releases/download/v7.6.5/powershell-7.6.5-linux-arm64.tar.gz",
    "mkdir -p /opt/microsoft/powershell/7",
    "tar zxf /tmp/powershell.tar.gz -C /opt/microsoft/powershell/7",
    "chmod +x /opt/microsoft/powershell/7/pwsh",
    "ln -s /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh",
    "npm install -g --ignore-scripts @earendil-works/pi-coding-agent",
    "pi install npm:pi-subagents",
    "pi install npm:pi-web-search"
  ],
  "launchCommand": ["pi"],
  "environmentVariables": [],
  "mounts": [
    {
      "hostPath": "~/.agents",
      "containerPath": "/root/.agents",
      "readOnly": true
    },
    {
      "hostPath": "~/.pi",
      "containerPath": "/root/.pi"
    }
  ]
}
