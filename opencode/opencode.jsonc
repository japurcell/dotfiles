{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "omlx (local)",
      "options": {
        "baseURL": "http://192.168.64.1:8080/v1",
      },
      "models": {
        "mlx-community--gpt-oss-20b-MXFP4-Q8": {
          "name": "mlx-community--gpt-oss-20b-MXFP4-Q8",
          "limit": {
            "context": 120000,
            "output": 8192,
          },
        },
        "gemma-4-26B-A4B-it-MLX-8bit": {
          "name": "gemma-4-26B-A4B-it-MLX-8bit",
          "limit": {
            "context": 120000,
            "output": 8192,
          },
        },
        "Qwen3.8-27B-8bit": {
          "name": "Qwen3.8 27B 8-bit",
          "limit": {
            "context": 120000,
            "output": 8192,
          },
          "options": {
            "concurrency": 2,
          },
        },
      },
    },
  },
}
